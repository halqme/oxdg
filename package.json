{
  "name": "oxdg",
  "version": "0.4.2",
  "description": "Fast, lightweight dependency graph CLI for JavaScript and TypeScript, built on Oxc",
  "keywords": [
    "circular-dependency",
    "dependency",
    "dependency-graph",
    "javascript",
    "madge",
    "module-graph",
    "oxc",
    "static-analysis",
    "typescript"
  ],
  "homepage": "https://github.com/halqme/oxdg#readme",
  "bugs": {
    "url": "https://github.com/halqme/oxdg/issues"
  },
  "license": "MIT",
  "author": "HALQME",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/halqme/oxdg.git"
  },
  "bin": {
    "oxdg": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p test/fixtures/tsconfig.typecheck.json --noEmit",
    "lint": "vp lint src",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "test": "bun test",
    "dev": "bun run src/cli/main.ts",
    "release:check": "node scripts/check-pack.mjs",
    "prepack": "bun run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "commander": "^15.0.0",
    "ignore": "^7.0.10",
    "oxc-parser": "^0.151.0",
    "oxc-resolver": "^11.24.2",
    "oxc-walker": "^1.1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.4.2"
}
